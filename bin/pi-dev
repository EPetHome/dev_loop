#!/usr/bin/env bash
# 参照旧 bin/pi-dev 的固定启动部分；不加载 Ponytail、旧 loop 或全局/项目扩展。
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PI_BIN="${PI_BIN:-/Users/Admin/.local/bin/pi}"
PI_NODE_BIN="${PI_NODE_BIN:-/Users/Admin/.hermes/node/bin}"
permission="${PERMISSION_EXTENSION:-/Users/Admin/.pi/agent/npm/node_modules/@gotgenes/pi-permission-system/src/index.ts}"
cwd="$PWD" model="openai-codex/gpt-6.2-sol" thinking="max" session="" sid="" name="" prompt="" dry="${PI_DEV_DRY_RUN:-0}"
die() { echo "pi-dev: $*" >&2; exit 2; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd|--model|--thinking|--session|--session-id|--name)
      [[ $# -ge 2 && -n "$2" ]] || die "$1 缺值"
      key="${1#--}"; key="${key//-/_}"
      case "$key" in session_id) sid="$2";; *) printf -v "$key" '%s' "$2";; esac
      shift 2;;
    --dry-run) dry=1; shift;;
    --help|-h) echo 'bin/pi-dev [--cwd 目录] [--model openai-codex/gpt-6.2-sol] [--thinking max] [--session 会话 | --session-id 编号] [--name 名称] [--dry-run] [提示词文件]'; exit 0;;
    -*) die "未知选项 $1";;
    *) [[ -z "$prompt" ]] || die "只能给一份提示词"; prompt="$1"; shift;;
  esac
done
[[ -d "$cwd" ]] || die "目录不存在：$cwd"
cwd="$(cd "$cwd" && pwd)"
[[ -n "$prompt" || -n "$session" ]] || die "缺提示词或恢复会话"
if [[ -n "$prompt" ]]; then
  prompt="${prompt#@}"
  [[ "$prompt" = /* ]] || prompt="$PWD/$prompt"
  [[ -f "$prompt" ]] || die "提示词不存在：$prompt"
fi
[[ -z "$sid" || -z "$session" ]] || die "session 与 session-id 不能同时使用"
[[ -x "$PI_BIN" && -f "$permission" ]] || die "找不到 pi 或权限扩展"
args=(--offline --model "$model" --thinking "$thinking"
  --no-extensions --no-mcp --no-skills --no-prompt-templates --no-themes
  --tools read,edit,write,bash -e "$permission" -e "$here/src/hosts/pi.ts")
[[ -z "$session" ]] || args+=(--session "$session")
[[ -z "$sid" ]] || args+=(--session-id "$sid")
[[ -z "$name" ]] || args+=(--name "$name")
[[ -z "$prompt" ]] || args+=("@$prompt")
if [[ "$dry" = 1 ]]; then printf 'cd %q\n' "$cwd"; printf '%q ' "$PI_BIN" "${args[@]}"; printf '\n'; exit 0; fi
cd "$cwd"
export PATH="$PI_NODE_BIN:$PATH"
exec "$PI_BIN" "${args[@]}"
